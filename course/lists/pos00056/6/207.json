2/34/19803/43354/634634ecEc7ae92be/dc34a8d975f68fcf.png\" /></a></p>", "contentAbstract": "", "contentCode": "content00867", "contentTitle": "双11来啦！供应链金融优惠助您“大麦”", "contentType": 2, "createTime": 1665543108000, "id": 2505, "link": "", "linkType": 0, "resCode": "100097", "srcUrl": "/vendor/wlimg10.360buyimg.com/jdwlcms/jfs/t1/195798/32/29528/56570/63462f43E6b933f91/9eb67bb8b10d98d5.jpg", "updateTime": 1677147368000}, {"content": "<p style=\"line-height: 1.5; text-align: right;\"><span style=\"color: #000000; font-family: 微软雅黑; font-size: 14px;\">[收录于&nbsp; <strong><em><a style=\"color: #000000;\" href=\"/news/2396/content00795?type=0\"><span style=\"text-decoration: underline;\">#链产品&nbsp;</span></a></em></strong> 合集]</span></p>\n<p style=\"line-height: 1.5;\">&nbsp;</p>\n<p style=\"text-align: center;\">&nbsp;</p>\n<p style=\"text-align: center;\"><img src=\"/vendor/wlimg10.360buyimg.com/jdwlcms/jfs/t1/218699/14/22022/1160523/63463400E5dd323bc/18f99e48a9bd17d6.png\" /></p>\n<p style=\"text-align: center;\">&nbsp;</p>\n<p style=\"text-align: center;\">&nbsp;</p>\n<p style=\"text-align: center;\">&nbsp;</p>\n<p style=\"text-align: center;\">&nbsp;</p>\n<p style=\"text-align: center;\">&nbsp;</p>\n<p style=\"text-align: center;\">&nbsp;</p>\n<p style=\"text-align: center;\"><a href=\"https://getwuce.jdl.com/#/diyForm?formCode=BD3187402377390195328&amp;channelL1Code=l1-ch8&amp;channelCode=wucech87219\" target=\"_blank\" rel=\"noopener\"><img src=\"/vendor/wlimg10.360buyimg.com/jdwlcms/jfs/t1/54354/8/21676/43354/63463551E549890b4/caeaaf66dd0e464a.png\" /></a></p>", "contentAbstract": "", "contentCode": "content00866", "contentTitle": "一图读懂京东物流如何助力商家获得“大促入场券”！", "contentType": 2, "createTime": 1665543063000, "id": 2504, "link": "", "linkType": 0, "resCode": "100097", "srcUrl": "/vendor/wlimg10.360buyimg.com/jdwlcms/jfs/t1/113253/30/30552/191695/6346341aEae96dc15/848718d680805cf8.png", "updateTime": 1677147351000}, {"content": "<p style=\"line-height: 1.5;\"><span style=\"color: #000000; font-family: 微软雅黑; font-size: 16px;\">10月8日，京东物流与泰森中国共建的位于山东日照的泰森山东自动化立体冷库开仓试运营。<strong>这是泰森中国与京东集团自去年达成战略合作关系后，双方在冷链物流方面围绕数智化仓储建设落地的最新合作成果。该项目克服了空间异形、坪效低等困难，实现了存储容量最大化、人工作业高效化的目标</strong>。</span></p>\n<p style=\"line-height: 1.5;\">&nbsp;</p>\n<p style=\"line-height: 1.5; text-align: center;\"><img src=\"/vendor/wlimg10.360buyimg.com/jdwlcms/jfs/t1/44377/26/18856/69557/63416033Ef38fac18/4955fce59aef27e8.jpg\" /></p>\n<p style=\"line-height: 1.5;\">&nbsp;</p>\n<p style=\"line-height: 1.5;\"><span style=\"color: #000000; font-family: 微软雅黑; font-size: 16px;\">作为全球领先的蛋白质产品的生产商及供应商，泰森食品拥有先进的蛋白质产品生产设备、完善的客户服务体系、强大的研发创新与市场推广支持，为全球100多个国家和地区提供健康、美味、便捷的蛋白质产品。</span></p>\n<p style=\"line-height: 1.5;\">&nbsp;</p>\n<p style=\"line-height: 1.5;\"><span style=\"color: #000000; font-family: 微软雅黑; font-size: 16px;\"><strong>根据京东集团与泰森中国签订的战略合作协议，双方将在供应链规划设计、冷链物流以及零售等多维度展开深度合作，帮助泰森中国降低应链端到端成本，更好地把握和服务终端客户需求，实现整个食品供应链效率的优化升级</strong>。</span></p>\n<p style=\"line-height: 1.5;\">&nbsp;</p>\n<p style=\"line-height: 1.5;\"><span style=\"color: #000000; font-family: 微软雅黑; font-size: 16px;\">此次，双方合作的自动化立体冷库分别位于泰森中国湖北孝感、江苏南通、山东日照的新建智慧工厂内，冷库温度为-18℃，用于原材料入库存储和成品的出入库，<strong>结合泰森未来规划发展定位，京东物流为其制定了后续一系列周密的软硬件升级改造计划</strong>。</span></p>\n<p style=\"line-height: 1.5;\">&nbsp;</p>\n<p style=\"line-height: 1.5; text-align: center;\"><img src=\"/vendor/wlimg10.360buyimg.com/jdwlcms/jfs/t1/143972/26/29830/347914/63416055Ed610e614/223c73123770a223.jpg\" /></p>\n<p style=\"line-height: 1.5;\">&nbsp;</p>\n<p style=\"line-height: 1.5;\"><span style=\"color: #000000; font-family: 微软雅黑; font-size: 16px;\">本次落地项目中，山东日照仓自动化立库高约17.8米，投入使用了双伸堆垛机、托盘输送机、地狼搬运AGV、四向车等多款智能仓储装备，配合包含有任务中心、调试中心、监控中心三大核心模块的WCS软件产品，采用RFID信息标签系统，<strong>实现了多设备协同作业与有序衔接，拉通出入库、分类存储的仓储主流程，大幅提升生产环节的作业效率，降低仓储成本，提高生产效率</strong>。</span></p>\n<p style=\"line-height: 1.5;\">&nbsp;</p>\n<p style=\"line-height: 1.5;\"><span style=\"color: #000000; font-family: 微软雅黑; font-size: 16px;\">与此同时，为了最大程度利用场地空间，京东物流为其规划堆垛机穿梭板立库的使用，进一步扩大了使用面积，<strong>根据泰森产品特征，设计了适应不同高度产品的货架，最终在有限的空间内规划出4927个货位，还为后续仓库容量扩展留有余地</strong>。</span></p>\n<p style=\"line-height: 1.5;\">&nbsp;</p>\n<p style=\"line-height: 1.5;\"><span style=\"color: #000000; font-family: 微软雅黑; font-size: 16px;\">此外，依托京东物流软硬件一体的技术优势，仓内采用WMS仓储管理系统和WCS仓储控制系统，提供更高效、精准的库存管理。<strong>而仓内的输送线循环设计，也可以使托盘在无人干预的情况下，实现自动供给回收，大大增加实用性与智能性</strong>。</span></p>\n<p style=\"line-height: 1.5;\">&nbsp;</p>\n<p style=\"line-height: 1.5; text-align: center;\"><img src=\"/vendor/wlimg10.360buyimg.com/jdwlcms/jfs/t1/203937/19/27283/119104/6341607eE3ae90a69/2ebe3ed3e11344c1.jpg\" /></p>\n<p style=\"line-height: 1.5;\">&nbsp;</p>\n<p style=\"line-height: 1.5;\"><span style=\"color: #000000; font-family: 微软雅黑; font-size: 16px;\">近两年，受多重因素影响，全球经济面临巨大的不确定性和挑战，供应链的数字化升级成为各企业重点解决的课题。对于食品行业来说，冷链的数字化升级更是势在必行。<strong>此次泰森山东自动化立体冷库项目正是冷链物流供应链数字化升级的落地成果，通过合理规划仓网与分布库存，把商品提前放在距离最近的仓库，可灵活匹配餐饮、零售客户与消费者的需求进行履约调度，还能利用大数据构建智能运算补货模型，降低物流成本、提高库存周转与运营效率，对食品行业供应链数字化升级具有重要示范意义</strong>。</span></p>\n<p style=\"line-height: 1.5;\">&nbsp;</p>\n<p style=\"line-height: 1.5;\"><span style=\"color: #000000; font-family: 微软雅黑; font-size: 16px;\">未来，京东物流将凭借数智化、高效、敏捷的一体化供应链物流服务体系，继续探索更多的行业解决方案，拓展服务广度和深度，解决更多客户的供应链难题，有效推动降本增效和产业升级，助力更多行业高质量发展。</span></p>\n<p style=\"line-height: 1.5;\">&nbsp;</p>\n<p style=\"line-height: 1.5;\">&nbsp;</p>\n<p style=\"line-height: 1.5;\">&nbsp;</p>\n<p style=\"line-height: 1.5;\">&nbsp;</p>\n<p style=\"line-height: 1.5;\">&nbsp;</p>\n<p style=\"line-height: 1.5;\">&nbsp;</p>\n<p style=\"line-height: 1.5; text-align: center;\"><a href=\"https://getwuce.jdl.com/#/diyForm?formCode=BD3187402377390195328&amp;channelL1Code=l1-ch8&amp;channelCode=wucech87219\" target=\"_blank\" rel=\"noopener\"><img src=\"/vendor/wlimg10.360buyimg.com/jdwlcms/jfs/t1/40418/20/19571/43354/634160e5E67605f97/489a74cfc4360768.png\" /></a></p>", "contentAbstract": "", "contentCode": "content00865", "contentTitle": "冷链数字化升级新范例！京东物流携手泰森中国打造自动化立体冷库，小空间创大价值", "contentType": 2, "createTime": 166522873000